<?xml version="1.0" encoding="utf-8"?>
<!--
  Vue vidéo de l'app (aperçu et plein écran). TextureView et non SurfaceView : l'image est dessinée dans la
  hiérarchie des vues. Avec une SurfaceView ajoutée dans un AndroidView de Compose, le plein écran restait noir
  (son présent) tant que rien n'était dessiné par-dessus (essai TCL 0.4.0). Le type de surface ne se choisit qu'ici.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    app:surface_type="texture_view"
    app:use_controller="false" />
