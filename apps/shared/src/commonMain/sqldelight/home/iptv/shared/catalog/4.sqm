-- Version 4 -> 5 : qualité réelle des films (définition, HDR, codec, son) lue dans la fiche du fournisseur. Les fiches
-- déjà gardées sont relues à la prochaine ouverture (date de lecture mise à 0 : périmées, mais encore servies hors ligne).
ALTER TABLE movie_detail ADD COLUMN tech TEXT;
UPDATE movie_fetch SET fetched_at = 0 WHERE key LIKE 'info:%';
