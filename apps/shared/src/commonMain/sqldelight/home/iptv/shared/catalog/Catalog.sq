CREATE TABLE live_category (
    id TEXT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    position INTEGER NOT NULL
);

CREATE TABLE live_stream (
    id TEXT PRIMARY KEY NOT NULL,
    category_id TEXT NOT NULL,
    name TEXT NOT NULL,
    icon TEXT,
    epg_channel_id TEXT,
    number INTEGER,
    position INTEGER NOT NULL
);

CREATE INDEX live_stream_category ON live_stream(category_id);

selectCategories:
SELECT id, name FROM live_category ORDER BY position;

selectCategoryIds:
SELECT id FROM live_category;

selectStreams:
SELECT id, category_id, name, icon, epg_channel_id, number FROM live_stream
WHERE category_id = ? ORDER BY position;

selectStreamsByIds:
SELECT id, category_id, name, icon, epg_channel_id, number FROM live_stream
WHERE id IN ?;

upsertCategory:
INSERT OR REPLACE INTO live_category(id, name, position) VALUES (?, ?, ?);

updateCategoryPosition:
UPDATE live_category SET name = ?, position = ? WHERE id = ?;

deleteCategory:
DELETE FROM live_category WHERE id = ?;

deleteStreamsOfCategory:
DELETE FROM live_stream WHERE category_id = ?;

insertStream:
INSERT OR REPLACE INTO live_stream(id, category_id, name, icon, epg_channel_id, number, position)
VALUES (?, ?, ?, ?, ?, ?, ?);

countCategories:
SELECT count(*) FROM live_category;

countStreams:
SELECT count(*) FROM live_stream WHERE category_id = ?;

selectGroupSources:
SELECT s.id, s.category_id, s.name FROM live_stream s
JOIN live_category c ON c.id = s.category_id
ORDER BY c.position, s.position, s.id;

-- Changement de compte IPTV (autre fournisseur) : le catalogue gardé sur la télé est vidé, il se recharge depuis le
-- nouveau fournisseur (sinon d'anciens titres et chaînes resteraient affichés). La progression est sur le serveur.
wipeLiveStreams:
DELETE FROM live_stream;
wipeLiveCategories:
DELETE FROM live_category;
wipeSeriesEpisodes:
DELETE FROM series_episode;
wipeSeriesSeasons:
DELETE FROM series_season;
wipeSeriesDetails:
DELETE FROM series_detail;
wipeSeriesItems:
DELETE FROM series_item;
wipeSeriesCategories:
DELETE FROM series_category;
wipeSeriesFetch:
DELETE FROM series_fetch;
wipeMovieDetails:
DELETE FROM movie_detail;
wipeMovieItems:
DELETE FROM movie_item;
wipeMovieCategories:
DELETE FROM movie_category;
wipeMovieFetch:
DELETE FROM movie_fetch;
